    <div class="container-fuild" ng-controller="ScheduleController">
        <div class="row" style="margin:15px 0px" ng-cloak>
            <div class="col-xs-12 col-sm-9 col-md-9 col-lg-9">
                <div class="panel panel-danger">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            <span class="glyphicon glyphicon-time"></span>
                            <span class="title-store">&nbsp;List Schedule</span>
                            </span>
                        </h3>
                        <span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
                    </div>
                    <div class="panel-body">
                        @include('schedule.filter')
                        @include('schedule.import')
                        <div class="table-responsive">
                            <div class="pull-left status-action">
                                <select ng-options="item.name for item in scheduleActionStatuses" ng-model="scheduleActionStatus"
                                    class="form-control status-action-option" ng-disabled="!checkAllListSchedule && !hasItemChecked"></select>
                                <button type="button" class="btn btn-success" ng-disabled="!checkAllListSchedule && !hasItemChecked" ng-click="changeListStatusHandler()">Save</button>
                            </div>
                            <table class="table table-hover table-bordered no-margin-bottom" id="schedule-list">
                                <thead>
                                    <tr>
                                        <!-- <th class="text-center vertical-align" style="width: 5%">
                                            
                                        </th> -->
                                        <th class="text-center vertical-align" style="width: 5%">
                                            <input type="checkbox" id="schedule-check-all" 
                                            ng-model="checkAllListSchedule" 
                                            ng-click="checkAllScheduleHandler()" 
                                            title="Check All"/>
                                            Index
                                        </th>
                                        <th class="col-md-5 text-center vertical-align">Schedule</th>
                                        <th class="col-md-1 text-center vertical-align">Status</th>
                                        <th class="col-md-2 text-center vertical-align">Project</th>
                                        <th class="col-md-2 text-center vertical-align">Create/ Update By</th>
                                        <th class="col-md-1 text-center vertical-align">Create<br />Update</th>
                                        <th class="text-center vertical-align">
                                            <button type="button" class="btn btn-sm btn-primary" ng-click="showForm()">
                                                <span class="glyphicon glyphicon-plus"></span> Add New
                                            </button>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in schedules track by $index">
                                        <td class="vertical-align text-center">
                                            <input type="checkbox" ng-model="item.checked" ng-change="changeSelectedState()" />
                                            [{$index + 1}]
                                        </td>
                                        <td class="vertical-align schedule-info">
                                            <p>Time: [{item.run_at}]</p>
                                            <p>URL:</p>
                                            <p ng-repeat="url in item.urls"><a href="[{url}]" target="_blank" title="[{url}]">[{url}]</a></p>
                                            <p ng-if="item.note">Note: [{item.note}]</p>
                                            <p ng-if="item.error_count > 0">
                                                <span class="label label-danger" title="Failed runs in the last [{stats.window_hours}]h">
                                                    <span class="glyphicon glyphicon-alert"></span>
                                                    [{item.error_count}] error(s) / [{stats.window_hours}]h
                                                </span>
                                            </p>
                                        </td>
                                        <td class="vertical-align">
                                            [{ getByField(statuses, 'code', item.status).name }]
                                        </td>
                                        <td class="vertical-align">
                                            <span ng-if="item.project_id">[{ getByField(projects, 'id', item.project_id).name }]</span>
                                        </td>
                                        <td class="vertical-align text-center actor">
                                            <label class="label label-primary block-item" title="Created By">[{item.creator_name}]</label>
                                            <label class="label label-primary block-item" title="Updated By">[{item.updator_name}]</label>
                                        </td>
                                        <td class="vertical-align text-center">
                                            <label class="label label-default block-item">[{summarizeDateTime(item.created_at, true)}]</label>
                                            <label class="label label-default block-item">[{summarizeDateTime(item.updated_at, true)}]</label>
                                        </td>
                                        <td class="vertical-align text-center">
                                            <div class="schedule-action">
                                                <button type="button" class="btn btn-sm btn-default" ng-click="viewLog(item)" title="Log Item">
                                                    <span class="glyphicon glyphicon-list-alt"></span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-warning" ng-click="clone(item)" title="Clone Item">
                                                    <span class="glyphicon glyphicon-duplicate"></span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-success" ng-click="edit(item)" title="Edit Item">
                                                    <span class="glyphicon glyphicon-pencil"></span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" ng-click="delete(item)" title="Delete Item">
                                                    <span class="glyphicon glyphicon-trash"></span>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-info" ng-click="requestNow(item)" title="Send now">
                                                    <span class="glyphicon glyphicon-send"></span>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr ng-show="schedules.length == 0">
                                        <td colspan="5">No data...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center">
                            @!component('common.pagination', accessPageId = "pageId", accessPagesCount = "pagesCount", accessFind = "find()" )
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-3 col-md-3 col-lg-3">
                <div class="panel" ng-class="stats.total_errors > 0 ? 'panel-danger' : 'panel-default'">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            <span class="glyphicon glyphicon-warning-sign"></span>
                            <span class="title-store">&nbsp;Failed Tasks ([{stats.window_hours}]h)</span>
                        </h3>
                        <span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
                    </div>
                    <div class="panel-body">
                        <div class="row text-center">
                            <div class="col-xs-6">
                                <h2 style="margin: 5px 0" ng-class="stats.total_errors > 0 ? 'text-danger' : 'text-muted'">[{stats.total_errors || 0}]</h2>
                                <small>Error runs</small>
                            </div>
                            <div class="col-xs-6">
                                <h2 style="margin: 5px 0" ng-class="stats.failing_schedules > 0 ? 'text-danger' : 'text-muted'">[{stats.failing_schedules || 0}]</h2>
                                <small>Failing tasks</small>
                            </div>
                        </div>
                        <p class="text-center text-success" style="margin-top: 10px" ng-if="stats.total_errors == 0">
                            <span class="glyphicon glyphicon-ok-sign"></span> No failed tasks
                        </p>
                        <div ng-if="stats.failed_links.length > 0" style="margin-top: 10px">
                            <hr style="margin: 8px 0" />
                            <strong style="font-size: 12px">Failed links</strong>
                            <ul class="list-unstyled" style="margin-top: 6px; margin-bottom: 0; max-height: 220px; overflow-y: auto">
                                <li ng-repeat="link in stats.failed_links | limitTo:5" style="margin-bottom: 8px">
                                    <span class="badge" style="background-color: #d9534f" title="Số lần chạy lỗi">[{link.error_count}]</span>
                                    <span class="label label-default" ng-if="link.last_status_code">[{link.last_status_code}]</span>
                                    <a href="[{link.url}]" target="_blank" title="[{link.url}]"
                                       style="display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; word-break: break-all;">[{link.url}]</a>
                                </li>
                            </ul>
                            <button type="button" class="btn btn-xs btn-link btn-block" style="margin-top: 2px; padding: 2px"
                                    ng-if="stats.failed_links.length > 5" ng-click="showFailedLinks()">
                                Xem thêm [{stats.failed_links.length - 5}] link
                                <span class="glyphicon glyphicon-chevron-down"></span>
                            </button>
                        </div>
                        <button type="button" class="btn btn-xs btn-default btn-block" style="margin-top: 10px" ng-click="fetchStats()">
                            <span class="glyphicon glyphicon-refresh"></span> Refresh
                        </button>
                    </div>
                </div>

                <!-- Popup: full list of failed links (scrollable) -->
                <div class="modal fade" id="failedLinksModal" tabindex="-1" role="dialog" aria-labelledby="failedLinksModalLabel">
                    <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                <h4 class="modal-title" id="failedLinksModalLabel">
                                    <span class="glyphicon glyphicon-warning-sign text-danger"></span>
                                    Failed links ([{stats.failed_links.length}]) &mdash; [{stats.window_hours}]h
                                </h4>
                            </div>
                            <div class="modal-body" style="max-height: 70vh; overflow-y: auto">
                                <table class="table table-striped table-condensed" style="margin-bottom: 0">
                                    <thead>
                                        <tr>
                                            <th style="width: 70px">Errors</th>
                                            <th style="width: 80px">Status</th>
                                            <th>URL</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="link in stats.failed_links">
                                            <td><span class="badge" style="background-color: #d9534f">[{link.error_count}]</span></td>
                                            <td><span class="label label-default" ng-if="link.last_status_code">[{link.last_status_code}]</span></td>
                                            <td style="word-break: break-all"><a href="[{link.url}]" target="_blank" title="[{link.url}]">[{link.url}]</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-default" data-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel panel-success">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            <span class="glyphicon glyphicon-th-list"></span>
                            <span class="title-store">&nbsp;Activity Run</span>
                            </span>
                        </h3>
                        <span class="pull-right clickable"><i class="glyphicon glyphicon-chevron-up"></i></span>
                    </div>
                    <div class="panel-body">
                        <div class="alert alert-info alert-dismissible" role="alert" ng-repeat="item in runs track by $index">
                            <strong>[[{item.method}]] - [{summarizeDateTime(item.runTime, true)}]</strong>
                            <a style="display: block" href="[{item.runLink}]" target="_blank" style="word-break: break-all;">[{item.runLink}]</a>
                        </div>
                        <div class="alert alert-warning alert-dismissible" role="alert" ng-show="runs.length == 0">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <strong>Warning!</strong> No links are scheduled...
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @include('schedule.form')
        @include('schedule.log')
        @include('project.form')
    </div>

@endsection

