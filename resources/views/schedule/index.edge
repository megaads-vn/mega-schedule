    <style>
        .status-action {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            height: 35px;
            width: 20%;
        }
        .status-action-option {
            margin-right: 10px;
        }
        .form-chosen .chosen-container, 
        .form-chosen .chosen-container .chosen-single {
            height: 34px;
        }
        .form-chosen .chosen-container .chosen-single {
            padding-top: 5px;
            font-size: 14px;
        }
        .form-chosen .chosen-container-single .chosen-single div {
            top: 5px;
        }
        .form-chosen .chosen-container .chosen-search input {
            border-radius: 3px;
            height: 30px;
        }
        .actor label {
            font-size: 80%;
            padding: 5px 0;
        }
        .schedule-url {
            display: inline-block; 
            max-width: 350px;  
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            vertical-align: middle;
            font-weight: 500;
        }
        .schedule-action {
            /* Kích hoạt Flexbox */
            display: flex;
            /* Cho phép các item xuống dòng khi không đủ chỗ */
            flex-wrap: wrap;
            /* Giới hạn chiều rộng của container để chứa vừa 2 nút */
            /* Giả định mỗi nút rộng khoảng 35px-40px. 
            40px * 2 nút + khoảng cách = khoảng 85px */
            max-width: 85px; 
            /* Căn giữa các nút nếu cần */
            justify-content: flex-start;
        }

        /* Tùy chọn: Thêm khoảng cách giữa các nút */
        .schedule-action button {
            margin: 2px; /* Thêm khoảng cách xung quanh mỗi nút */
        }
    </style>
